# Copie para .env.production e preencha antes de publicar.
# Banco novo e separado do ambiente de desenvolvimento.
POSTGRES_USER=doceponto
POSTGRES_DB=doceponto
POSTGRES_PASSWORD=
# Gere um segredo aleatório com: node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h
ADMIN_NOME=Administradora
ADMIN_EMAIL=
# Criação inicial: mínimo de 8 caracteres, máximo de 72 bytes.
# Alterar esta variável depois não troca a senha de uma conta já cadastrada.
ADMIN_SENHA=
# Endereço HTTPS definitivo, sem barra final.
PUBLIC_ORIGIN=
HTTP_PORT=8080
