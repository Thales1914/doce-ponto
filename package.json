{
  "name": "doceponto",
  "version": "1.0.0",
  "private": true,
  "description": "Comandos de desenvolvimento, testes e deploy do DocePonto",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "setup": "npm --prefix backend ci && npm --prefix frontend ci",
    "start": "docker compose --env-file .env -f deploy/compose.yml up -d --build --wait",
    "stop": "docker compose --env-file .env -f deploy/compose.yml stop",
    "status": "docker compose --env-file .env -f deploy/compose.yml ps",
    "logs": "docker compose --env-file .env -f deploy/compose.yml logs --tail 100",
    "start:backend": "npm --prefix backend start",
    "dev": "npm --prefix backend run dev",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "migrate": "npm --prefix backend run migrate",
    "build": "npm --prefix frontend run build",
    "build:frontend": "npm --prefix frontend run build",
    "test": "node scripts/test-docker.cjs",
    "test:backend": "npm --prefix backend test",
    "test:frontend": "npm --prefix frontend test",
    "test:local": "node scripts/test-docker.cjs",
    "test:docker": "node scripts/test-docker.cjs",
    "test:production": "node scripts/production-smoke.cjs",
    "deploy:prepare": "node scripts/prepare-deploy.cjs",
    "deploy:check": "node scripts/check-deploy.cjs",
    "deploy": "node scripts/deploy.cjs",
    "backup": "node scripts/backup-db.cjs"
  },
  "license": "UNLICENSED"
}
